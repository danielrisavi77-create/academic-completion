# Canonical Academic Completion production origin.
# Required by /api/health and the production E2E acceptance gate.
COMPLETION_APP_URL=https://academic-completion.netlify.app

# Shared Academic Suite Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY

# Lekta handoff (optional override; production default is lektahr.netlify.app)
LEKTA_APP_URL=https://lektahr.netlify.app

# Live contextual AI — server only
ANTHROPIC_API_KEY=SERVER_ONLY_ANTHROPIC_KEY

# Manual production authority acceptance only. Never set this permanently in hosting.
# PRODUCTION_E2E_CONFIRM=CREATE_AND_DELETE_E2E_DATA
